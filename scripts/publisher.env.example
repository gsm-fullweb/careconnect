# Copie este arquivo para um .env na RAIZ do projeto e preencha os valores.
# O .env já está no .gitignore — a chave secreta NÃO vai para o git.
#
#   cp scripts/publisher.env.example .env
#
# A service_role key fica em: Supabase -> Project Settings -> API -> service_role
# NUNCA compartilhe essa chave nem faça commit dela.

# Opcional — já tem default para o projeto CareConnect
SUPABASE_URL=https://dyxkbbojlyppizsgjjxx.supabase.co

# OBRIGATÓRIA para gravar (secreta!)
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-sua-service-role-key

# Opcional — UUID de um profile admin para preencher author_id dos posts
BLOG_AUTHOR_ID=
