{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    { "source": "/Admin", "destination": "/admin", "permanent": true },
    { "source": "/Admin/login", "destination": "/admin/login", "permanent": true },
    { "source": "/Admin/:path*", "destination": "/admin/:path*", "permanent": true },
    { "source": "/sobre", "destination": "/about", "permanent": true },
    { "source": "/servicos", "destination": "/services", "permanent": true },
    { "source": "/planos", "destination": "/plans", "permanent": true },
    { "source": "/contato", "destination": "/contact", "permanent": true },
    { "source": "/cuidadores-mogi", "destination": "/cuidador-idosos-mogi-das-cruzes", "permanent": true }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(cuidador-idosos-mogi-das-cruzes|cuidador-mogi-das-cruzes|duvidas-frequentes-cuidador-de-idosos|qual-o-valor-da-diaria-do-cuidador-de-idoso|quanto-e-12-horas-de-uma-cuidadora|como-contratar-cuidador-sem-vinculo-empregaticio|qual-valor-cobrar-para-cuidar-de-um-idoso|home-care-mogi-das-cruzes-trabalhe-conosco|cuidare-mogi-das-cruzes|acuidar-mogi-das-cruzes-cuidadores-de-idosos|casa-de-repouso-mogi-das-cruzes-trabalhe-conosco|home-angels-mogi-das-cruzes|avaliacoes-sobre-cuidare-mogi-das-cruzes|vagas-de-cuidadora-de-idosos-particular)",
      "destination": "/api/lp-render?path=$1",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|LinkedInBot|Slack|WhatsApp|Telegram|Discordbot|Applebot).*"
        }
      ]
    },
    {
      "source": "/blog/(.*)",
      "destination": "/api/blog-render?slug=$1",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Twitterbot|facebookexternalhit|LinkedInBot|Slack|WhatsApp|Telegram|bingbot|YandexBot|DuckDuckBot|Baiduspider|Discordbot|Applebot).*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],

  "headers": [
    {
      "source": "/(robots.txt|og-image.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.gif|.*\\.ico|.*\\.svg|.*\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.woff|.*\\.woff2|.*\\.ttf|.*\\.eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=1, stale-while-revalidate=59"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
